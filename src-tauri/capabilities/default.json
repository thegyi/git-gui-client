{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capabilities for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "dialog:default",
    "dialog:allow-open",
    "opener:default"
  ]
}
